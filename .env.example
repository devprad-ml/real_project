DATABASE_URL=dummydburl
# Owner/superuser URL used only by `alembic upgrade`. DATABASE_URL above is the
# narrow app_user, which cannot CREATE TABLE or GRANT. Leave unset where the
# single DATABASE_URL already has those rights (CI).
ALEMBIC_DATABASE_URL=dummy_superuser_dburl
ANTHROPIC_API_KEY=dummy_key
BLOB_BACKEND=local 
CONFIDENCE_THRESHOLD=0.85
MAX_ATTEMPTS=5
DOWNSTREAM_BASE_URL=dummy_url
BLOB_LOCAL_ROOT=dummy_local_root
CLASSIFY_MODEL=claude-sonnet-5
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=